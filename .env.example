# NEXGRAFT AI — local configuration. Copy to .env and edit (start.bat does this for you).

# ---- Ollama -------------------------------------------------------------
OLLAMA_HOST=http://127.0.0.1:11434
# Chat model. Empty = auto-pick the first installed Qwen chat model.
# 4 GB GPU (GTX 1650 Ti): qwen2.5:3b fits fully in VRAM; qwen3:4b is smarter (use NUM_CTX 4096).
NEXGRAFT_MODEL=
# Embedding model for semantic retrieval (ollama pull nomic-embed-text). Missing = keyword retrieval.
NEXGRAFT_EMBED_MODEL=nomic-embed-text
# Vision model for image input. Empty = auto-detect (e.g. ollama pull qwen2.5vl:3b or moondream).
NEXGRAFT_VISION_MODEL=
# Optional per-workspace models (each switch costs a few seconds of loading on a 4 GB GPU):
# NEXGRAFT_MODEL_BIOINFORMATICS=qwen2.5-coder:3b
# NEXGRAFT_MODEL_MEDICAL=
# NEXGRAFT_MODEL_HARDWARE=
# NEXGRAFT_MODEL_GENERAL=
# Fine-tuned models built with finetune.bat (nexgraft-bioinformatics, nexgraft-hardware) are used for their
# workspace unless a model is set above. false = never use them.
NEXGRAFT_FINETUNED=true

# ---- Generation -------------------------------------------------------
NEXGRAFT_NUM_CTX=8192
NEXGRAFT_NUM_PREDICT=1200
NEXGRAFT_TEMPERATURE=0.4
NEXGRAFT_KEEP_ALIVE=15m

# ---- Orchestration ----------------------------------------------------
# hybrid = LLM analyzer with keyword fallback, heuristic = keyword router only (fastest)
NEXGRAFT_ROUTER=hybrid
NEXGRAFT_ANALYZER_TIMEOUT=60
NEXGRAFT_SYNTHESIS=true

# ---- Tools ------------------------------------------------------------
# Europe PMC literature search for Medical Research AI (needs internet)
NEXGRAFT_LITERATURE=true
# "Run locally" button for generated Python in Bioinformatics AI (runs on your computer)
NEXGRAFT_CODE_RUNNER=true
NEXGRAFT_CODE_TIMEOUT=60

# ---- Server -----------------------------------------------------------
NEXGRAFT_HOST=127.0.0.1
NEXGRAFT_PORT=8000
# To demo from another device on your Wi-Fi: set NEXGRAFT_HOST=0.0.0.0 and add your LAN IP here.
# NEXGRAFT_ALLOWED_HOSTS=192.168.1.20

# ---- 3D hero (Spline) -------------------------------------------------
# A https://prod.spline.design/<id>/scene.splinecode URL, or leave empty and drop an exported
# scene.splinecode into frontend/public/spline/. Empty = built-in offline orbit animation.
NEXGRAFT_SPLINE_SCENE=
# Optional GLB model for the interactive WebGL hero core (or drop it at frontend/public/models/hero.glb).
NEXGRAFT_HERO_MODEL=
